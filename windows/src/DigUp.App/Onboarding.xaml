<Window x:Class="DigUp.App.Onboarding"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DigUp setup" Width="520" Height="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
  <DockPanel Margin="18">
    <TextBlock x:Name="Heading" DockPanel.Dock="Top" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" Text="Find your files by meaning" />
    <TextBlock x:Name="Step" DockPanel.Dock="Top" Foreground="Gray" Margin="0,0,0,12" Text="Step 1 of 4" />
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="Back" Content="Back" Width="90" Margin="0,0,8,0" Click="OnBack" />
      <Button x:Name="Next" Content="Next" Width="90" IsDefault="True" Click="OnNext" />
    </StackPanel>
    <Grid>
      <StackPanel x:Name="P0" Visibility="Visible">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Text="Pick the folders to search. DigUp reads pictures, PDFs, documents, recordings and videos in them — on your PC only, nothing uploaded." />
        <TextBlock TextWrapping="Wrap" Foreground="Gray" Text="Then press Ctrl+Alt+Space anywhere and describe what you look for." />
      </StackPanel>
      <StackPanel x:Name="P1" Visibility="Collapsed">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Text="Which folders should DigUp search?" />
        <ListBox x:Name="Folders" Height="150" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal">
          <Button Content="Add…" Width="90" Margin="0,0,8,0" Click="OnAdd" />
          <Button Content="Remove" Width="90" Click="OnRemove" />
        </StackPanel>
        <TextBlock x:Name="Estimate" Foreground="Gray" Margin="0,10,0,0" Text="estimating…" />
      </StackPanel>
      <StackPanel x:Name="P2" Visibility="Collapsed">
        <CheckBox x:Name="Code" Content="Also search my code" FontSize="14" Margin="0,0,0,8" />
        <TextBlock TextWrapping="Wrap" Foreground="Gray" Text="Off by default. When on, searches starting with code: find functions by what they do. Code never shows in other searches." />
      </StackPanel>
      <StackPanel x:Name="P3" Visibility="Collapsed">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Text="One download first: the search model (865 MB, once). After that everything runs offline." />
        <ProgressBar x:Name="Bar" Height="18" Minimum="0" Maximum="100" Margin="0,0,0,8" />
        <TextBlock x:Name="DlStatus" Foreground="Gray" Text="waiting…" />
      </StackPanel>
      <StackPanel x:Name="P4" Visibility="Collapsed">
        <TextBlock FontSize="14" TextWrapping="Wrap" Margin="0,0,0,8" Text="You're set. DigUp is reading your files in the background (tray icon, bottom right)." />
        <TextBlock TextWrapping="Wrap" Foreground="Gray" Text="Press Ctrl+Alt+Space in any app and describe what you look for. Change anything later in tray menu → Settings." />
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
