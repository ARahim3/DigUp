<Window x:Class="DigUp.App.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preview" Width="880" Height="660" MinWidth="520" MinHeight="380"
        WindowStyle="None" Background="#282828" Topmost="True"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <!-- One seamless surface (same tone as the search card). Opaque on
       purpose: video frames don't render in transparent windows. -->
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#3A3A3A" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="7"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#4A4A4A" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#0078D4" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </Window.Resources>
  <Border Background="#282828" CornerRadius="10" Padding="16"
          BorderBrush="#4A4A4A" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Margin="0,0,0,10">
        <TextBlock x:Name="Title" FontSize="16" FontWeight="SemiBold" Foreground="White"
                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="48" />
        <TextBlock x:Name="Kind" FontSize="12" Foreground="#AAAAAA" Margin="0,2,0,0" />
      </StackPanel>
      <!-- Pictures and video fit the space (no scrolling); words scroll. -->
      <Grid Grid.Row="1">
        <Image x:Name="Picture" Stretch="Uniform" Visibility="Collapsed"
               HorizontalAlignment="Center" VerticalAlignment="Center" />
        <MediaElement x:Name="Player" Stretch="Uniform" Visibility="Collapsed"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      LoadedBehavior="Manual" UnloadedBehavior="Close" />
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" x:Name="WordsScroll"
                    Visibility="Collapsed">
        <TextBox x:Name="Words" IsReadOnly="True"
                 Background="Transparent" Foreground="#DDDDDD" FontSize="14"
                 BorderThickness="0" TextWrapping="Wrap" />
      </ScrollViewer>
      <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0"
                  x:Name="Transport" Visibility="Collapsed">
        <Button x:Name="PlayPause" Content="Pause" Width="80" Margin="0,0,8,0" Click="OnPlayPause" Focusable="False" />
        <TextBlock x:Name="Time" Foreground="#AAAAAA" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
        <Button Content="Open" Width="80" Margin="0,0,8,0" Click="OnOpen" Focusable="False" />
        <Button Content="Close" Width="80" Margin="0,0,16,0" Click="OnClose" Focusable="False" />
        <TextBlock Foreground="#888888" VerticalAlignment="Center"
                   Text="Space or Esc closes · Enter opens" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
