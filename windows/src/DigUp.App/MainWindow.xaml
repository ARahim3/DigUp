<Window x:Class="DigUp.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DigUp" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowState="Maximized" Topmost="True" ShowInTaskbar="False" ShowActivated="True">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#3A3A3A" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="7"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#4A4A4A" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#0078D4" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </Window.Resources>
  <Grid x:Name="Root" MouseDown="OnBackdrop">
    <Rectangle x:Name="DimRect" Fill="Black" Opacity="0.45" />
    <Border x:Name="Card" Width="680" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,110,0,0">
      <Border Background="#282828" CornerRadius="14" Padding="14"
              BorderBrush="#4A4A4A" BorderThickness="1">
        <Border.Effect>
          <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.6" Color="Black" />
        </Border.Effect>
        <StackPanel>
          <TextBox x:Name="Query" FontSize="20" Padding="10,8" Background="#333333" Foreground="White"
                   CaretBrush="White" BorderThickness="0" Margin="0,0,0,10"
                   ToolTip="Describe what you look for. code: finds code. Enter opens, Esc hides." />
          <ListBox x:Name="Results" FontSize="14" MaxHeight="300" Background="Transparent" Foreground="White"
                   BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,6">
                  <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" Foreground="White" />
                  <TextBlock Foreground="#AAAAAA" Text="{Binding Detail}" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="8,2" />
                <Style.Triggers>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0078D4" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>
          <Border x:Name="PreviewBox" Margin="0,10,0,0" Background="#303030" CornerRadius="8" Padding="10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Image x:Name="PreviewImage" Grid.Column="0" MaxHeight="180" Stretch="Uniform" Margin="0,0,10,0" />
              <StackPanel Grid.Column="1">
                <TextBlock x:Name="PreviewTitle" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                <TextBlock x:Name="PreviewKind" Foreground="#AAAAAA" Margin="0,2,0,6" />
                <TextBlock x:Name="PreviewText" Foreground="#DDDDDD" TextWrapping="Wrap" MaxHeight="120"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <Button Content="Open" Width="80" Margin="0,0,8,0" Click="OnOpenButton" Focusable="False" />
                  <Button Content="Show in Explorer" Width="120" Margin="0,0,8,0" Click="OnShowButton" Focusable="False" />
                  <Button Content="Copy" Width="70" Click="OnCopyButton" Focusable="False" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>
          <TextBlock x:Name="Status" Foreground="#888888" Margin="0,8,0,0" Text="starting…" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
