{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DigUp",
  "version": "0.7.0-beta.1",
  "identifier": "com.abdurrahim.DigUp",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Search your files by what's in them, on your computer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installerHooks": "windows/hooks.nsh" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1RDdFMkE2N0Y2RkRERkEKUldUNjNXOS9wdUxYRmRKRUZHQk4zZFYrVTV5amV5akxqT0Q3UjduVk9aRHpuVlduRkE4Z2dDQjYK",
      "endpoints": ["https://raw.githubusercontent.com/ARahim3/DigUp/main/updates/latest.json"],
      "requireSignedVersion": true
    }
  }
}
