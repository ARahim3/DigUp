module CLlama [system] {
    header "../../Vendor/llama/include/llama.h"
    header "../../Vendor/llama/include/mtmd.h"
    header "../../Vendor/llama/include/mtmd-helper.h"
    header "../../Vendor/llama/include/llama-build.h"
    link "llamacpp"
    link "c++"
    // NOTE: macOS framework links (Accelerate/Metal/MetalKit/Foundation) used to
    // live here, but modulemaps have no per-OS conditionals and `link framework`
    // breaks Linux linking. macOS frameworks are linked via the LlamaRuntime
    // target's linkerSettings in Package.swift instead.
    export *
}
