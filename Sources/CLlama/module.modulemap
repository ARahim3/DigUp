module CLlama [system] {
    header "../../Vendor/llama/include/llama.h"
    header "../../Vendor/llama/include/mtmd.h"
    header "../../Vendor/llama/include/mtmd-helper.h"
    header "../../Vendor/llama/include/llama-build.h"
    // NOTE: linking lives in the LlamaRuntime target's linkerSettings in
    // Package.swift (modulemaps have no per-OS conditionals): -lllamacpp and
    // the C++/system frameworks on macOS, the original static archives with
    // --start-group plus stdc++/gomp on Linux.
    export *
}
