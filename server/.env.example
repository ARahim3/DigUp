# DigUp server — configuration (every setting is an environment variable; copy to .env).
# No secrets here, no media paths chosen by clients, no cloud services.

# Where the engine's index lives (`--index <here>`, always explicit — the CLI default is
# the desktop app's folder, not a server volume). Writable.
DIGUP_SERVER_INDEX=/data/index

# Media roots the server may search, pathsep-separated, mounted read-only. The API never
# accepts roots, paths, or URLs from a client (docs/implementation/README.md §7).
DIGUP_SERVER_ROOTS=/media/photos

# The model folder, published as DIGUP_MODELS — the *only* place ModelFiles.swift looks.
# Pin it so a stray HF cache can't feed the engine a different model.
DIGUP_SERVER_MODELS=/data/models

# The engine binary (default: `digup` on PATH — the payload in /opt/digup).
#DIGUP_SERVER_BINARY=digup

# The static UI folder FastAPI serves at `/` (default: the built Lit+Vite frontend at
# `server/ui/dist` inside the image — built by the frontend-builder stage, shipped as
# static files; Node never runs at runtime). Point it elsewhere only for a dev checkout
# with its own `npm run build`; a value with no index.html is a startup error, by design.
#DIGUP_SERVER_UI=

# Folders to leave out of the crawl (`--exclude`, pathsep-separated) and extensions to
# skip (`--exclude-ext`, comma-separated, e.g. "jpg,heic").
#DIGUP_SERVER_EXCLUDE=
#DIGUP_SERVER_EXCLUDE_EXT=

# Seconds the query encoder stays warm after the last keystroke (`--encoder-idle`; the
# engine releases the model at this and exits itself at 2× — the adapter restarts it).
#DIGUP_SERVER_ENCODER_IDLE=300

# Seconds the CLI's identity answers (fingerprints, per-kind counts, index size) stay
# cached, so the UI's 15 s polls and the container's healthcheck don't each spawn a
# `digup status` counting run on the writer's hot index (api.py StatusCache).
#DIGUP_SERVER_STATUS_TTL_S=15

# Startup prewarm: the engine's `prewarm` op opens the vectors and warms the encoder at
# boot, so the first search answers with real z-scores (model load paid at startup, not
# in front of a user). Set 0 to skip it on dev restarts.
#DIGUP_SERVER_PREWARM=1

# Backfill: after syncing, the writer keeps embedding the long tail (rest of long PDFs
# and documents) inside the same job — the engine's `--backfill`. Set 0 to sync only.
#DIGUP_SERVER_BACKFILL=1

# Job log rotation size in bytes; rotated logs chain `jobs.jsonl.1 … .N` (higher is
# older) and history replays from all of them. Default 1 MiB.
#DIGUP_SERVER_JOB_LOG_SIZE=1048576

# A job's ceiling in seconds (default 3600). Corpora finish in minutes; a real tree's
# first pass outlives an hour — when the ceiling expires the job records *interrupted*
# with its partial counters and the next job resumes (an honest stop, not a failure).
#DIGUP_SERVER_JOB_TIMEOUT_S=3600

# Estimate's ceiling in seconds (default 120). A full crawl of a large media tree on a
# spinning disk needs minutes; raise this for trees in the 100k-files range.
#DIGUP_SERVER_ESTIMATE_TIMEOUT_S=120

# Job log: append-only JSON-lines (`jobs.jsonl`) beside the server's config — the job
# states survive a restart, and a `running` line with no ending recovers as *interrupted*.
# Default: `<index>/server-config`. Put it on a volume (Compose: /data/config).
#DIGUP_SERVER_CONFIG=/data/config

# API bind. Default is loopback only; LAN exposure requires authentication first (§7).
# In a container, bind 0.0.0.0 inside and publish 127.0.0.1:8787:8787 on the host.
#DIGUP_SERVER_HOST=127.0.0.1
#DIGUP_SERVER_PORT=8787

# Explicit Host and Origin validation (opt-in; OFF by default — a localhost-only server
# validates nothing it was not asked to). Name the URL hosts this deployment serves,
# comma-separated: then a request whose Host is not listed answers 400, and a browser's
# state-changing request (POST/PUT/PATCH/DELETE) whose Origin is not the request's own host
# answers 403. Clients that send no Origin (curl, Immich, Home Assistant, agents) pass;
# read-only GETs are not checked. Ports are not compared, and there is no wildcard — "*" is
# a host literally named "*". Set this when the server is reachable from a Docker network,
# a reverse proxy, or a LAN name; leave it unset for loopback-only.
#DIGUP_SERVER_ALLOWED_HOSTS=127.0.0.1,localhost,digup.lan

# Bearer tokens (OFF by default — a loopback server has no auth state to leak). Set the read
# token to guard every /api/v1 endpoint except health/docs/openapi; set the admin token to
# guard POST /index and POST /estimate on top of it. 401 without a token, 403 for the read
# token on an admin endpoint. The UI prompts and keeps the token in localStorage (digupBearer).
# Admin-only (no read token) guards the mutating endpoints and leaves search open on the box.
#DIGUP_SERVER_TOKEN=
#DIGUP_SERVER_ADMIN_TOKEN=

# Named read tokens (opt-in, OFF by default): `name:token` pairs, comma-separated. Each
# entry guards the read scope exactly like DIGUP_SERVER_TOKEN — index/estimate stay
# admin-only — and every guarded request is logged with the name that asked
# (`principal=nc-a`), so one server answering several applications (Nextcloud instances,
# dashboards, Immich) can revoke one client's secret without touching the others.
# Names are lowercased; the first value wins per name; a malformed entry is skipped with
# a named warning line.
#DIGUP_SERVER_READ_TOKENS=nc-a:secret-a,nc-b:secret-b

# The standalone box mints its own API key at boot (the UI's API key row, with Copy;
# main-page reads stay key-free). Applications bring that key to
# `POST /api/v1/targets` at the running server and get their OWN private key + their
# OWN index folder, crawled in the background (docs/API.md "Named indexes").
#DIGUP_SERVER_MINT_KEYS=1

# Named indexes (opt-in, stage 13): `name=roots:index` entries, semicolon-separated —
# the roots colon-separated (as in DIGUP_SERVER_ROOTS), the index the LAST folder.
# Each entry is an APPLICATION's own index the same server
# supervises independently — its own searcher, writer lock, jobs log, previews. When a
# target's token is not in DIGUP_SERVER_READ_TOKENS as `app:<name>:<secret>`, the server
# MINTS one (stored 0600 in the config folder, shown in the UI's API key rows
# and `GET /api/v1/tokens`, admin scope only). Names are lowercase slugs (`media` is
# the main index's, reserved); paths absolute; a target's index may not be the main
# index. The full contract: docs/API.md "Named indexes".
#DIGUP_SERVER_APP_TARGETS=nextcloud=/media/nextcloud:/data/index-nextcloud

# CORS for browser widgets (opt-in, OFF by default): exact origins, comma-separated
# (`http://nextcloud.lan:8081`). Neither the server's own UI (same origin) nor
# server-to-server clients (PHP, curl, agents — no `Origin` header) need this; it exists
# for the served embed page (`/embed.html`) hosted inside another application's page.
# An allowlisted origin gets preflight grants and decorated answers; every other origin
# gets nothing. The Host allowlist above still outranks everything.
#DIGUP_SERVER_ALLOWED_ORIGINS=http://nextcloud.lan:8081

# Dev containers must run the API with a real parent (`docker run --init`, or tini as
# PID 1): ParentWatch helpers exit when their parent is PID 1 — see §15 item 8.
